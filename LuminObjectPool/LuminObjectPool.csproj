<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <TargetFrameworks>netstandard2.1;net8.0;net9.0</TargetFrameworks>
        <RootNamespace>LuminObjectPool</RootNamespace>
        <NoWarn>$(NoWarn);CS1591;CA2255</NoWarn>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>LuminObjectPool</PackageId>
        <Version>2.0.0</Version>
        <Authors>TheLight233</Authors>
        <Description>High-performance object pool library with selectable concurrency strategies: thread-local atomic slots, MPMC ring buffer, MPSC/SPMC/SPSC rings, and a single-threaded pool. Configured with delegates instead of policy types.</Description>
        <PackageTags>pooling;object-pool;high-performance;lock-free;ring-buffer;mpsc;spmc;spsc;unity</PackageTags>
        <PackageProjectUrl>https://github.com/TheLight-233/LuminObjectPool</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TheLight-233/LuminObjectPool.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
    
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

</Project>
